# MinVoice / LiveKit 开发用凭据模板
#
# 复制为 credentials.env 并填入你自己的 LiveKit 服务器信息：
#   cp credentials.env.example credentials.env && chmod 600 credentials.env
#
# 用途：本机开发时 MinVoice 会从这个文件预填服务器凭据（见 README）。
# 安全提醒：API Secret 等同服务器 root 权限（可签发任意房间 token），
# 该文件已被 .gitignore 排除（livekit/credentials*），不要提交或外发。
#
# 如果使用 LiveKit Cloud 或自建服务，把下面的地址换成你的入口即可。

# ---- 服务端 SDK 用（签发 token）----
LIVEKIT_URL=wss://livekit.example.com:7443
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=replace-with-your-64-char-secret

# ---- 浏览器/客户端用（只暴露地址，密钥绝不下发）----
LIVEKIT_WS_URL=wss://livekit.example.com:7443
LIVEKIT_HTTP_URL=https://livekit.example.com:7443

# ---- 内置 TURN（仅 UDP，兼作 STUN；服务端会自动写进 join response，一般无需配置）----
LIVEKIT_TURN_URL=turn:livekit.example.com:3478?transport=udp
LIVEKIT_TURN_UDP_PORT=3478
